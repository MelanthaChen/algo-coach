{
  "manifest_version": 3,
  "name": "AlgoCoach",
  "version": "0.1.0",
  "description": "Interactive DSA coaching, visualization, and learning notes directly on LeetCode problem pages.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AlgoCoach"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
