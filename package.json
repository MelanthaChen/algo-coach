{
  "name": "algo-coach",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoCoach turns LeetCode problem pages into guided DSA learning sessions.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-icons.mjs",
    "dev": "vite build --watch",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "validate:difficulties": "node scripts/validate-problem-difficulties.mjs",
    "validate:visualizers": "node scripts/validate-visualizer-selection.mjs",
    "validate:patterns": "node scripts/validate-pattern-classification.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.10.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.1"
  }
}
